{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "lead",
  "subagent_depth": 1,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": ["npx", "-y", "@colbymchenry/codegraph@1.5.0", "serve", "--mcp"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": false
    },
    "markitdown": {
      "type": "local",
      "command": ["uvx", "markitdown-mcp@0.0.1a4"],
      "enabled": false
    },
    "headroom": {
      "type": "local",
      "command": ["uvx", "--from", "headroom-ai[mcp]", "headroom", "mcp", "serve"],
      "enabled": false
    }
  },
  "permission": {
    "chrome-devtools*": "deny",
    "playwright*": "deny"
  }
}