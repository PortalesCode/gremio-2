{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "lead",
  "subagent_depth": 1,
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "codegraph": {
        "type": "local",
        "command": ["npx", "-y", "@colbymchenry/codegraph@1.5.0", "serve", "--mcp"]
      },
      "sequential-thinking": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"]
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
        "disabled": true
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp"],
        "disabled": true
      },
      "markitdown": {
        "type": "local",
        "command": ["uvx", "markitdown-mcp@0.0.1a4"],
        "disabled": true
      },
      "headroom": {
        "type": "local",
        "command": ["uvx", "--from", "headroom-ai[mcp]", "headroom", "mcp", "serve"],
        "disabled": true
      }
    }
  },
  "permissions": [
    { "action": "chrome-devtools_*", "resource": "*", "effect": "deny" },
    { "action": "playwright_*", "resource": "*", "effect": "deny" }
  ]
}